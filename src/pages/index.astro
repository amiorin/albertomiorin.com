---
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import BigConfig from '~/components/BigConfig.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Features3 from '~/components/widgets/Features3.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Personal Homepage Demo',
};
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>
  <Fragment slot="footer"></Fragment>
  <Fragment slot="header">
    <Header
      links={[
        { text: 'Home', href: '#' },
        { text: 'About', href: '#about' },
        { text: 'FDE', href: '#FDE' },
        { text: 'big-config ↗', href: 'https://big-config.it', target: '_blank' },
        { text: 'blog ↗', href: 'https://big-config.it/blog', target: '_blank' },
      ]}
      actions={[
        {
          text: 'Contact me',
          href: '/contact#form',
        },
      ]}
      isSticky
      showToggleTheme
    />
  </Fragment>

  <!-- Hero2 Widget ******************* -->

  <Hero
    id="hero"
    title="Alberto Miorin"
    tagline="Forward Deployed Engineer"
    actions={[{ variant: 'primary', text: 'Contact me', href: getPermalink('/contact#form') }]}
  >
    <Fragment slot="subtitle">
      I’m a software engineer who works directly with customers to customize, integrate, and deploy my open-source
      project <BigConfig /> to solve their specific technical challenges in operations and developer experience.
    </Fragment>
  </Hero>

  <!-- Content Widget **************** -->

  <Content
    id="about"
    columns={3}
    items={[
      {
        icon: 'tabler:brand-github',
        callToAction: {
          target: '_blank',
          text: 'GitHub',
          href: 'https://github.com/amiorin',
        },
      },
      {
        icon: 'tabler:brand-slack',
        callToAction: {
          target: '_blank',
          text: 'Slack',
          href: 'https://clojurians.slack.com/team/U071UT57Y7Q',
        },
      },
      {
        icon: 'tabler:brand-linkedin',
        callToAction: {
          target: '_blank',
          text: 'Linkedin',
          href: 'https://www.linkedin.com/in/albertomiorin/',
        },
      },
    ]}
    image={{
      src: '~/assets/images/avatar.png',
      alt: 'Colorful Image',
      loading: 'eager',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">About me</h2>
      <p>I'm on a journey to make the operations and developer experience better.</p>
      <p>
        For this reason I have create the open-source project <BigConfig />
      </p>
      <p>If you're curious to dive deeper into my work, you can follow me:</p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Features3 Widget ************** -->

  <Features3
    id="FDE"
    title="Forward Deployed Engineering"
    subtitle="Forward deployed engineering (FDE) is a unique, customer-facing role where software engineers work directly with clients to solve complex, real-world problems. Unlike traditional software engineers who focus on building a single product for many customers, FDEs focus on creating many capabilities for a single customer."
    columns={3}
    defaultIcon="tabler:point-filled"
    items={[
      {
        title: 'Customer-facing',
        description: 'I work directly with clients to understand their needs.',
      },
      {
        title: 'Customization',
        description: "I write one-off code and scripts to tailor the product to a specific client's environment.",
      },
      {
        title: 'Troubleshooting',
        description: 'I acts as a first responder for complex, client-specific technical issues.',
      },
      {
        title: 'Business Alignment',
        description: 'I translate customer feedback and business needs into technical requirements.',
      },
      {
        title: 'High Travel',
        description: 'I travel to client sites.',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    title="Let's fix operations"
    subtitle="Ready to transform your engineering platforms?"
    actions={[
      {
        variant: 'primary',
        text: 'Contact me',
        href: '/contact#form',
      },
    ]}
  />
</Layout>
