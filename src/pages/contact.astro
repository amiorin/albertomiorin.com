---
import Layout from '~/layouts/PageLayout.astro';
import Header from '~/components/widgets/Header.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactMe from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contact',
};
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>
  <Fragment slot="footer"></Fragment>
  <Fragment slot="header">
    <Header
      links={[
        { text: 'Home', href: '/#' },
        { text: 'About', href: '/#about' },
        { text: 'FDE', href: '/#FDE' },
        { text: 'big-config ↗', href: 'https://big-config.it' },
        { text: 'Github ↗', href: 'https://github.com/amiorin' },
      ]}
      actions={[
        {
          text: 'Contact me',
          href: '/contact#form',
        },
      ]}
      isSticky
      showToggleTheme
    />
  </Fragment>

  <!-- HeroText Widget ******************* -->

  <HeroText tagline="Contact" title="Let's Connect!" />

  <ContactMe
    id="form"
    title="Drop me a message today!"
    subtitle="Tell me more about the problems of your engineering platforms. I can help you to solve them."
    inputs={[
      {
        type: 'text',
        name: 'name',
        label: 'Name',
      },
      {
        type: 'email',
        name: 'email',
        label: 'Email',
      },
    ]}
    textarea={{
      label: 'Message',
    }}
    disclaimer={{
      label:
        'By submitting this contact form, you acknowledge and agree to the collection of your personal information.',
    }}
    description="I typically responds within 24 business hours."
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="I'm here to help!"
    items={[
      {
        title: 'Reduce attrition',
        description: `One of the reason for software engineers to leave companies is the frustration with the low-productivity platform`,
      },
      {
        title: 'Increase operation excellence',
        description: 'More automation, less incidents cause because of the human factor',
      },
      {
        title: `Increase developers productivity`,
        description: `More automation, less time-consuming in manual steps`,
      },
      {
        title: 'Email',
        description: `<a href="mailto:contact@albertomiorin.com">contact@albertomiorin.com</a>`,
        icon: 'tabler:mail',
      },
      {
        title: 'Location',
        description: 'Berlin',
        icon: 'tabler:map-pin',
      },
      {
        title: 'Slack',
        description: `<a href="https://clojurians.slack.com/team/U071UT57Y7Q">@amiorin</a>`,
        icon: 'tabler:brand-slack',
      },
    ]}
  />
</Layout>
